+    /// Dogfood Round 2 (Finding 1): the real, current `GoalPreferences`
+    /// for this phase's own `Goal` — the exact same construction
+    /// `StrategicPlanSelectionViewModel.acceptAndStart` already uses at
+    /// initial phase start, reused here so a later tactical roll respects
+    /// the same athlete-approved availability, including any change made
+    /// through `TrainingPreferencesSettingsView` since the phase started.
+    /// Falls back to the same defaults `GoalPreferences` itself documents
+    /// (`availableTrainingDaysPerWeek` unset -> 4, doubles unset -> false)
+    /// when no preference has ever been stated — never blocks on it.
+    ///
+    /// Dogfood Round 2 (Finding 1) — Independent Review Correction 1: now
+    /// also threads the athlete's real `GoalPreferences.availableWeekdays`
+    /// into `UserAvailability.availableWeekdays` — the ONE existing
+    /// authority `ConcurrentScheduler.hardCheck`/`isUsable` already
+    /// enforces as a hard constraint. `nil`/never-chosen degrades to `[]`
+    /// (`UserAvailability`'s own documented "no explicit restriction, every
+    /// day usable" meaning), preserving exactly today's behavior for every
+    /// athlete who has never opened the new weekday editor — never a
+    /// guessed subset inferred from the legacy day-count integer.
+    private static func currentAvailability(phase: TrainingPhase) -> UserAvailability {
+        let preferences = phase.plan?.goal?.preferences
+        let availableWeekdays = preferences?.availableWeekdays ?? []
+        let trainingDays = availableWeekdays.isEmpty ? (preferences?.availableTrainingDaysPerWeek ?? 4) : availableWeekdays.count
+        let allowsDoubles = preferences?.allowsDoubleSessions ?? false
+        return UserAvailability(
+            trainingDaysPerWeek: trainingDays, availableWeekdays: availableWeekdays,
+            allowsDoubleSessions: allowsDoubles, maxSessionsPerDay: allowsDoubles ? 2 : 1
+        )
+    }
